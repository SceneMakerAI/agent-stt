# ── 비밀값 (절대 커밋 금지)
.env
.env.*
!.env.example

# 인증서 / 개인키 — 확장자 전체를 막는다.
#   ⚠ '.pem' 이라고만 쓰면 '.pem' 이라는 이름의 파일만 걸리고 'xxx.pem' 은 안 걸린다
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*

# ── Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/

# ── 가상환경 / uv
.venv/

# ── 산출물 / 중간 덤프 (검수용, 커밋 불필요)
output/

# ── 에디터 / OS
.vscode/
.idea/
*.swp
.DS_Store

# ── 테스트 / 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
