# .env.example — 복사해서 .env 로 만들고 값을 채운다.
#   ⚠ .env 는 DB 비밀번호를 담으므로 커밋 금지 (.gitignore 에 포함)
#   config.py 가 읽는 키는 여기 전부 있어야 한다 — 하나라도 빠지면 기동 시 죽는다.

# ── 이 서버 (FastAPI)
HOST=0.0.0.0
PORT=19010

# ── 준비 + 전사 워커 (worker-prep_stt)
#    ffmpeg(음성·프레임 추출) 과 1·2차 전사를 모두 이 워커가 맡는다
STT_HOST=127.0.0.1
STT_PORT=8000

# ── vLLM (Qwen) — 검색 질의·교정·할루시 필터·요약
VLLM_HOST=127.0.0.1
VLLM_PORT=8000

# ── MariaDB — 상태 갱신 + 자막·프레임 결과 저장
RDB_HOST=127.0.0.1
RDB_PORT=3306
RDB_USER=mydb
RDB_PW=mydb
RDB_NAME=mydb

# ── 다음 단계 — agent-vision
#    VISION_TRIGGER: 저장 완료 후 vision 을 부를지. 미연동이면 false
#    ("true"/"1"/"on"/"yes" → on, 그 외/미설정 → off)
VISION_HOST=127.0.0.1
VISION_PORT=8001
VISION_TRIGGER=false

# ── 이미지 검출 워커 (worker-img_models) — /sport/{baseball,soccer}
IMG_MODELS_HOST=127.0.0.1
IMG_MODELS_PORT=8004

# ── 디버그 — 단계별 중간 결과 덤프 (검수용, write-only)
#    다음 단계가 절대 읽지 않는다. 끄려면 true 이외의 값(false 등).
DUMP_DIR=output/
DUMP_STEPS_STT=true
DUMP_STEPS_ROSTER=true
DUMP_STEPS_WHISPER=true
DUMP_STEPS_CORRECT=true
DUMP_STEPS_HALLU=true
DUMP_STEPS_SUMMARY=true
